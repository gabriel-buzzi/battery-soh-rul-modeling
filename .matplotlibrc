#### MATPLOTLIBRC FORMAT ####

## TEXT AND FONTS
text.usetex:         False
font.family:         serif
font.serif:          Times New Roman, Times
font.size:           11.0

## VECTOR FONT EMBEDDING
pdf.fonttype:        42
ps.fonttype:         42
svg.fonttype:        none

## AXES AND TICKS
axes.labelsize:      11.0
axes.titlesize:      11.0
figure.titlesize:    13.0
figure.titleweight:  normal
axes.linewidth:      0.8
axes.grid:           False

xtick.labelsize:     9.0
ytick.labelsize:     9.0
xtick.direction:     in
ytick.direction:     in
xtick.top:           True
ytick.right:         True
xtick.major.size:    3.5
xtick.minor.size:    2.0
xtick.minor.visible: False
ytick.minor.visible: False

## LEGEND
legend.fontsize:     9.0
legend.frameon:      False
legend.loc:          best

## LINES AND MARKERS
lines.linewidth:     1.0
lines.markersize:    4.5
errorbar.capsize:    2.0

## FIGURE AND SAVING
figure.constrained_layout.use: True
savefig.dpi:         500
savefig.format:      pdf
savefig.bbox:        tight
savefig.pad_inches:  0.05

## COLOR CYCLE (High-contrast qualitative)
axes.prop_cycle: cycler('color', ['0072B2', '009E73', 'D55E00', 'CC79A7', 'F0E442', '56B4E9'])

## LIGHTWEIGHT SETTINGS
path.simplify: True           # Removes "invisible" points on lines
path.simplify_threshold: 0.1  # Increase (up to 1.0) to simplify more aggressively
agg.path.chunksize: 10000     # Helps with very large datasets
